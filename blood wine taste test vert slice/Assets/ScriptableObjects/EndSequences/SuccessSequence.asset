    _charSprite: {fileID: 0}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: Either way, I'll need her response.
  - _speaker: 0
    _charSprite: {fileID: 21300000, guid: a7221be3902993e49920b17cf290b8cb, type: 3}
    _CG: {fileID: 0}
    _music: {fileID: 0}
