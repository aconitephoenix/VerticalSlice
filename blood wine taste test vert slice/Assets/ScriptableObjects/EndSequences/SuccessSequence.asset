    _charSprite: {fileID: 21300000, guid: 85e73fbc318d21e4db7461e9136fd8c7, type: 3}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: You can choose for yourself and surprise me with a second glass.
