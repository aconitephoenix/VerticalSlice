%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6626c84bb700413428bce8fec5aff79d, type: 3}
  m_Name: FailSequence
  m_EditorClassIdentifier: 
  _sameOptionTarget: 0
  _lines:
  - _speaker: 1
    _charSprite: {fileID: 21300000, guid: 4bb070eb7f25b4d43b4cd5ca28562347, type: 3}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: "\u2026 oh would you look at that; time's up."
  - _speaker: 1
    _charSprite: {fileID: 21300000, guid: e5765cb552eb0e743b1d025dd7e12a90, type: 3}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: And what did I get out of that time? NOTHING!!!
  - _speaker: 1
    _charSprite: {fileID: 0}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: Ugh, don't even know what I expected, you're all just the same...
  - _speaker: 0
    _charSprite: {fileID: 21300000, guid: a7221be3902993e49920b17cf290b8cb, type: 3}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: Sincerest apologies for disappointing you, Jessi. I suppose my
      approach could've been better.
  - _speaker: 1
    _charSprite: {fileID: 0}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: As if. Just get out of here. We're done.
  - _speaker: 0
    _charSprite: {fileID: 21300000, guid: 632048a77c40f4449afafb4f2cd57c28, type: 3}
    _CG: {fileID: 0}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: Hmph. Very well then.
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: Failure..? It's not becoming of me to fail at something as simple
      as entertaining that idiot.
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: I planned everything perfectly, and yet...
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: "\u2026 no, the fault doesn't lie within me."
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: It's all her fault.
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: You can't expect anything from scum like her.
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: That worthless excuse of a human cannot possibly understand what
      I could give her.
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: Right...Jessi Atwood...
  - _speaker: 2
    _charSprite: {fileID: 0}
    _CG: {fileID: 7482667652216324306, guid: 9959a4df59af56a44b7ca1a158fbd31b, type: 3}
    _music: {fileID: 0}
    _shakeCamera: 0
    _triggerHeartbeat: 0
    _maxFriendship: 0
    _dialogueLine: "\u2026 is human trash."
  _playerReplyOptions: []
  _npcReplies: []
  _gameEnd: 0
